<Window x:Class="CirCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CirCalc"
        mc:Ignorable="d"
        Title="CirCalc" Height="450" Width="800">
    <Grid Margin="10,10,419,21">

        <Grid x:Name="Grid2" Background="lightblue">
            <Label Content="Please enter Radius: " HorizontalAlignment="Left" Margin="29,34,0,0" VerticalAlignment="Top" FontSize="14"/>
            <TextBox x:Name="RBox" HorizontalAlignment="Left" Margin="171,38,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" FontSize="14"/>
            <Label Content="Please enter colour:" HorizontalAlignment="Left" Margin="29,68,0,0" VerticalAlignment="Top" FontSize="14"/>
            <TextBox x:Name="CBox" HorizontalAlignment="Left" Margin="171,72,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" FontSize="14"/>
            <Button x:Name="ExitBtn" Content="Exit" HorizontalAlignment="Left" Margin="171,351,0,0" VerticalAlignment="Top" FontSize="14" Width="120" Click="ExitBtn_Click"/>
            <Button Content="Calculate" HorizontalAlignment="Left" Margin="171,105,0,0" VerticalAlignment="Top" FontSize="14" Width="120" Click="Button_Click"/>
            <Label Content="Radius:" HorizontalAlignment="Left" Margin="29,145,0,0" VerticalAlignment="Top" FontSize="14"/>
            <Label Content="Diameter:" HorizontalAlignment="Left" Margin="29,192,0,0" VerticalAlignment="Top" FontSize="14"/>
            <Label Content="Surface Area:" HorizontalAlignment="Left" Margin="29,239,0,0" VerticalAlignment="Top" FontSize="14"/>
            <Label Content="Circumference:" HorizontalAlignment="Left" Margin="29,287,0,0" VerticalAlignment="Top" FontSize="14"/>
            <TextBox x:Name="R2Box" HorizontalAlignment="Left" Margin="171,149,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" FontSize="14"/>
            <TextBox x:Name="DBox" HorizontalAlignment="Left" Margin="171,196,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" FontSize="14"/>
            <TextBox x:Name="ABox" HorizontalAlignment="Left" Margin="171,243,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" FontSize="14"/>
            <TextBox x:Name="CBox1" HorizontalAlignment="Left" Margin="171,291,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" FontSize="14"/>
            <Button x:Name="HelpBtn" Content="Help" HorizontalAlignment="Left" Margin="29,351,0,0" VerticalAlignment="Top" Width="68" FontSize="14" Click="HelpBtn_Click"/>
        </Grid>
        <Grid x:Name="Grid3" Margin="404,0,-405,0" Background="LightGray">
            <Canvas x:Name="DrawBoard">
                <Ellipse x:Name="Circle1" Height="100" Canvas.Left="10" Stroke="Black" Canvas.Top="10" Width="100" StrokeThickness="4"/>
            </Canvas>
        </Grid>


    </Grid>
</Window>
